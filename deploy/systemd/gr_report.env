# Configuration of the gr_report service (systemd EnvironmentFile).
# Every setting corresponds to a command line flag, see `gr_report -h`.

# Listen address as host:port. An empty host listens on all interfaces.
GR_REPORT_ADDR=:8443

# Data directory (SQLite database, lock, initial admin password).
GR_REPORT_DATA=/var/lib/gr_report

# TLS certificate chain and private key (PEM). Create them with
# scripts/mkcert-selfsigned.sh or scripts/mkcert-letsencrypt.sh.
GR_REPORT_TLS_CERT=/etc/gr_report/tls/cert.pem
GR_REPORT_TLS_KEY=/etc/gr_report/tls/key.pem

# Default user interface language (en or sv) for browsers that state no
# preference; also the language of the starter templates on first start.
GR_REPORT_LANG=en

# In-process sandbox: strict refuses to start when Landlock (file system and
# network) or seccomp is unavailable. Use auto on kernels older than 6.7.
GR_REPORT_SANDBOX=strict
